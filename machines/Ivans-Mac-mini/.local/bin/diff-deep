#!/usr/bin/env bash
EXCLUDES=(
  .git
  .direnv
  .claude
  .DS_Store
  .rumdl_cache
  .stfolder
  .terraform
  .terraform.lock.hcl
  "terraform.tfstate*"
  "workspace*"
)

EXCLUDE_ARGS=()
for e in "${EXCLUDES[@]}"; do
  EXCLUDE_ARGS+=("--exclude=$e")
done

diff -ru "${EXCLUDE_ARGS[@]}" "$@" | delta
