{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "cleanupPeriodDays": 30,
  "editorMode": "vim",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
  },
  "feedbackSurveyRate": 0,
  "permissions": {
    "allow": [
      "Read(${homeWorkPath}/Sources/**)",
      "Bash(git add:*)",
      "Bash(git log:*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "Bash(nix-prefetch-url:*)",
      "Read(${home}/.config/**)",
      "Read(${home}/.local/**)"
    ],
    "autoApproveWebFetch": true,
    "defaultMode": "auto",
    "deny": [
      "Bash(sudo:*)"
    ]
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "skillOverrides": {
    "gcx": "name-only",
    "json-canvas": "name-only",
    "obsidian-bases": "name-only",
    "obsidian-cli": "name-only",
    "package-usage": "name-only",
    "provider-upgrade": "name-only",
    "pulumi-automation-api": "name-only",
    "pulumi-best-practices": "name-only",
    "pulumi-component": "name-only",
    "pulumi-context-api": "name-only",
    "pulumi-debug-failed-operation": "name-only",
    "pulumi-esc": "name-only",
    "pulumi-overview": "name-only",
    "pulumi-upgrade-provider": "name-only"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "${home}/.local/bin/claude-statusline",
    "type": "command"
  },
  "theme": "dark",
  "tui": "default"
}
